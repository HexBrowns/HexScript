--[[
ローポリ背景.obj2 v3.10

  通常 : ジッター格子 → Bowyer-Watson Delaunay → cbuffer バッチで HLSL 塗り。
         メッシュは EffectUtils_Lowpoly 側でメモ化されるので、アニメ OFF なら再計算は初回のみ。
  高速 : 三角形分割も色決定も HLSL 内で完結する 1 パス版。
         セルごとに対角の向きをハッシュで振るので、格子固定対角のような縞バイアスは出ない。

不透明度は本体標準の「透明度」と重複するので v3.00 で廃止した。

明転 (v3.02) は三角形ごとに遅延を持たせて暗色から立ち上げる。RGB の一律スケールなので
色相・彩度が保たれ、純黒を経由しない。開始明度 100% で厳密な恒等になり、OFF のときも
含めて v3.01 と同じ絵が出る。

配色 (v3.03) にランダムを追加した。三角形ごとの乱数で色1と色2を振り分け、「中間色」で
その境目にランプを入れる。グラデーションのときは v3.02 と同じ絵が出る。
「通常」の乱数は三角形番号ではなく頂点番号から作る（メッシュアニメで番号が入れ替わってもちらつかない）。

v3.10 で乱数を作り直した。「通常」の EffectUtils_Lowpoly.hash21 が実体は等差数列で、色相と明度が
連動して極端値が同じ三角形に重なっていた（周囲から浮いた三角形の原因）。「高速」の hash21f は
シードが大きいと float32 で潰れて、メッシュが規則格子に戻っていた。**どちらもメッシュと配色が
v3.03 から変わる（シード 0 でも変わる）。** 形・グラデーション・明転の挙動は変えていない。

※このコメント内で行頭に @ を置かないこと。ホストはブロックコメントの中も走査し、
  行頭 @ をセクション区切りとして扱うため、偽のスクリプトがエフェクト一覧に並ぶ。
]]

@通常
--information:通常@ローポリ背景 v3.11 by HexBrowns
--label:HexScript
--object

--check@screen_size:画面サイズに合わせる,1
--track@width:幅,1,8192,1920,1
--hide@width:screen_size==1
--track@height:高さ,1,8192,1080,1
--hide@height:screen_size==1

--group:メッシュの設定
--track@cell_size:セルサイズ,20,500,100,1
--track@jitter:揺らぎ,0,100,40,0.1
--track@seed:シード,-9999,9999,0,1
--separator:※CPU分割のためセルは点数上限で自動的に粗くなります
--group

--group:色設定,1
--color@color1:色1,0x2980b9
--color@color2:色2,0x8e44ad
--select@color_mode:配色=0,グラデーション=0,ランダム=1
--select@gradient_dir:グラデ方向=0,縦=0,横=1,対角=2
--hide@gradient_dir:color_mode==1
--track@mix_ratio:色2の割合,0,100,50,1
--hide@mix_ratio:color_mode==0
--track@mix_blend:中間色,0,100,0,1
--hide@mix_blend:color_mode==0
--track@hue_var:色相変化(±度),0,180,15,1
--track@val_var:明度変化(±%),0,100,20,1
--group

--group:アニメ,0
--check@animate:メッシュ,0
--check@anim_hue:色相,0
--check@anim_val:明度,0
--track@loop_count:ループ回数,1,64,1,1
--group

--group:エッジ,0
--check@show_edges:エッジ表示,0
--track@edge_width:エッジ幅,0.5,5,1,0.1
--hide@edge_width:show_edges==0
--color@edge_color:エッジ色,0x000000
--hide@edge_color:show_edges==0
--group

--group:明転,0
--check@fade_in:明転を使う,0
--select@fade_order:明ける順=0,ランダム=0,グラデ方向=1,明るい順=2,暗い順=3,中心から=4
--hide@fade_order:fade_in==0
--track@fade_spread:ばらつき,0,100,60,1
--hide@fade_spread:fade_in==0
--track@fade_dark:開始明度,0,100,10,1
--hide@fade_dark:fade_in==0
--track@fade_len:所要時間,1,100,50,1
--hide@fade_len:fade_in==0
--separator:※所要時間はオブジェクト長に対する割合です
--group

--[[pixelshader@ps_lpbg_fill:
// 1 パス 256 三角形。Lua 側 EffectUtils_Lowpoly.BATCH_SIZE と必ず一致させること。
cbuffer Params : register(b0) {
    float4 meta;      // w, h, tri_count, show_edges
    float4 edge;      // r, g, b, edge_width
    float4 tri[768];  // 256 tris * 3 float4
};

float sign2d(float2 p1, float2 p2, float2 p3) {
    return (p1.x - p3.x) * (p2.y - p3.y) - (p2.x - p3.x) * (p1.y - p3.y);
}

bool point_in_tri(float2 pt, float2 v0, float2 v1, float2 v2) {
    float d1 = sign2d(pt, v0, v1);
    float d2 = sign2d(pt, v1, v2);
    float d3 = sign2d(pt, v2, v0);
    bool has_neg = (d1 < 0) || (d2 < 0) || (d3 < 0);
    bool has_pos = (d1 > 0) || (d2 > 0) || (d3 > 0);
    return !(has_neg && has_pos);
}

float dist_seg(float2 p, float2 a, float2 b) {
    float2 pa = p - a;
    float2 ba = b - a;
    float denom = dot(ba, ba);
    float h = (denom > 1e-8) ? saturate(dot(pa, ba) / denom) : 0.0;
    return length(pa - ba * h);
}

float4 ps_lpbg_fill(float4 sv_pos : SV_Position, float2 texcoord : TEXCOORD) : SV_Target {
    float2 pos = sv_pos.xy;
    int count = (int)meta.z;

    float4 result = float4(0.0, 0.0, 0.0, 0.0);
    [loop]
    for (int i = 0; i < 256; i++) {
        if (i >= count) break;
        int base = i * 3;
        float2 v0 = tri[base].xy;
        float2 v1 = tri[base].zw;
        float2 v2 = tri[base + 1].xy;
        float a = tri[base + 2].y;
        if (a <= 0.0) continue;
        if (point_in_tri(pos, v0, v1, v2)) {
            float3 rgb = float3(tri[base + 1].z, tri[base + 1].w, tri[base + 2].x);
            if (meta.w > 0.5) {
                float d = min(min(dist_seg(pos, v0, v1), dist_seg(pos, v1, v2)), dist_seg(pos, v2, v0));
                float ea = 1.0 - smoothstep(edge.w * 0.5, edge.w * 0.5 + 1.0, d);
                rgb = lerp(rgb, edge.rgb, ea);
            }
            result = float4(rgb * a, a);
            break;
        }
    }
    return result;
}
]]

local ok_lp, lp = pcall(require, "EffectUtils_Lowpoly")
if not ok_lp or not lp then
  return
end

local w, h
if lp.as_bool(screen_size, true) then
  w, h = obj.screen_w, obj.screen_h
else
  w = math.max(math.floor(width + 0.5), 1)
  h = math.max(math.floor(height + 0.5), 1)
end
if w < 1 or h < 1 then
  return
end

local is_edges = lp.as_bool(show_edges, false)

-- ループ位相は全て loop_count 基準の整数周回なので、端が必ず繋がる
local mesh_phase = lp.loop_phase(animate, loop_count, obj)
local hue_phase = lp.loop_phase(anim_hue, loop_count, obj)
local val_phase = lp.loop_phase(anim_val, loop_count, obj)

local r1, g1, b1 = lp.color_to_rgb01(color1)
local r2, g2, b2 = lp.color_to_rgb01(color2)
local er, eg, eb = lp.color_to_rgb01(edge_color)
local gdir = gradient_dir or 0
local color_random = (color_mode or 0) == 1
local mix_blend01 = (mix_blend or 0) / 100
local mix_center = lp.random_mix_center((mix_ratio or 50) / 100, mix_blend01)

-- 明転。OFF のときは dark = 1 で fade_mix が厳密な恒等になるので、v3.01 と同じ絵が出る
local fade_on = lp.as_bool(fade_in, false)
local fade_prog, fade_dark01, fade_spread01 = 1, 1, 0
if fade_on then
  fade_prog = math.min(lp.object_progress(obj) / math.max(fade_len / 100, 0.01), 1)
  fade_dark01 = fade_dark / 100
  fade_spread01 = fade_spread / 100
  if is_edges then
    -- エッジ色は cbuffer 全体で 1 つなので三角形ごとの係数を持てない。
    -- 中央 (key=0.5) の係数で近似する。@高速 側はシェーダー内で三角形ごとに掛かる。
    er, eg, eb = lp.fade_mix(er, eg, eb, lp.fade_factor(fade_prog, 0.5, fade_spread01), fade_dark01)
  end
end

obj.clearbuffer("object", w, h)

local points, tris = lp.get_mesh(w, h, cell_size, jitter, seed, mesh_phase)
if #tris < 1 then
  return
end

local recs = lp.build_tri_records(points, tris, function(i, t, p0, p1, p2)
  local cx = (p0.x + p1.x + p2.x) / 3
  local cy = (p0.y + p1.y + p2.y) / 3
  local mix_t
  if color_random then
    mix_t = lp.random_mix_t(lp.tri_vertex_hash(t, 13, seed + 700), mix_center, mix_blend01)
  else
    mix_t = lp.gradient_t(cx, cy, w, h, gdir)
  end
  local r, g, b = lp.color_at(
    mix_t, r1, g1, b1, r2, g2, b2, i, seed, hue_var, val_var, hue_phase, val_phase)
  if fade_on then
    local key = lp.fade_key(fade_order, i, seed, cx, cy, w, h, gdir, r, g, b, mix_t)
    r, g, b = lp.fade_mix(r, g, b, lp.fade_factor(fade_prog, key, fade_spread01), fade_dark01)
  end
  return r, g, b, 1
end)

local batch = lp.BATCH_SIZE
for start = 1, #recs, batch do
  local consts = {
    w, h, 0, is_edges and 1 or 0,
    er, eg, eb, edge_width,
  }
  local n = lp.append_tri_batch(consts, recs, start, batch)
  consts[3] = n
  obj.pixelshader("ps_lpbg_fill", "object", nil, consts, "draw")
end

@高速
--information:高速@ローポリ背景 v3.11 by HexBrowns
--label:HexScript
--object

--check@screen_size:画面サイズに合わせる,1
--track@width:幅,1,8192,1920,1
--hide@width:screen_size==1
--track@height:高さ,1,8192,1080,1
