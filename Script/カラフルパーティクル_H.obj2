--information:カラフルパーティクル_H v1.00 by HexBrowns
--label:HexScript
--object

--group:発生
--track@track0:頻度,0.1,500,10,0.1
--track@track1:距離,1,10000,500,1
--track@track2:速度,1,2000,400,1
--track@track3:方向,-360,360,0,0.1
--track@dir_ran:ランダム方向,0,360,30,0.1
--track@v_ran:ランダム速度[-%],0,100,0,0.1
--track@x_ran:X軸ランダム,0,10000,0,1
--track@y_ran:Y軸ランダム,0,10000,0,1
--group

--group:図形
--figure@name:種類,円
--track@f_size:サイズ,1,2000,100,1
--track@f_line:ライン幅,1,4000,4000,1
--check@colorful:カラフル,1
--color@col:色,0xffffff
--hide@col:colorful==1
--group

--group:変化
--track@av:透過速度[%],0,100,100,0.1
--track@sv:拡大速度[%],-100,1000,0,0.1
--track@s_ran:ランダム拡大[-%],0,100,0,0.1
--track@rz_ran:ランダムZ角度,0,360,0,0.1
--track@rzv_ran:ランダムZ回転,0,3600,0,0.1
--group

--[[
@FIGURE.obj2 の @カラフルパーティクル（第三者作）を軽くした版。原作は残してある。

原作が重い理由
  オブジェクトの長さ全体で出る粒（頻度 x 長さ 個）すべてについて、毎フレーム
  「図形の読み込み → フィルタ効果の実行 → 描画」をしていた。まだ出ていない粒と
  消えた粒は透明度 0 で描かれるだけで、見た目には何も出ていない。

本版で変えたこと
  ・いま飛んでいる粒（頻度 x 寿命 個）だけを回す。描く順・位置・色・乱数は原作と同じ
  ・「カラフル」を OFF にすると色を指定でき、図形の読み込みとフィルタ効果の実行が 1 フレーム 1 回になる
  ・旧形式の --dialog を --track@ / --figure@ / --check@ に置き換えた
  ・原作で常に 0 だった未使用の乱数（XY 角度・Z など）を呼ばない

検証器: AI/scripts/カラフルパーティクル_H/verify_colorful_particle.py
]]

local obj, math = obj, math

local b = 1 / track0          -- 出力間隔(秒)
local l = track1              -- 距離
local v = l / track2          -- 距離を進むのにかかる時間(=寿命)
local dir = -track3 + 90      -- 出力方向
local rad = math.pi / 180
local time = obj.time
local n = obj.totaltime / b

-- 粒 i は時刻 i*b に出て i*b + v に消える。見えるのは (time - v) < i*b < time の粒だけ。
-- 端は下のループの中で原作と同じ t の判定をするので、ここは 1 つずつ広めに取る
local i_lo = math.max(0, math.floor((time - v) / b) - 1)
local i_hi = math.min(math.ceil(n) - 1, math.ceil(time / b) + 1)

local function colorful_color(i)
  local c = (obj.rand(0, 100, i, 100) - 50) / 100
  if c < 0 then
    return math.floor(math.cos(math.pi * c) * 255) * 256 + math.floor(math.sin(math.pi * -c) * 255)
  end
  return math.floor(math.cos(math.pi * c) * 255) * 256 + math.floor(math.sin(math.pi * c) * 255) * 65536
end

local loaded, drawn = false, false
for i = i_lo, i_hi do
  -- 原作のループ範囲（0 〜 n-1）の外は描かない
  if i <= n - 1 then
    local t = (v - time + i * b) / v
    t = math.min(1, math.max(t, 0))
    if t ~= 0 and t ~= 1 then
      if colorful == 1 then
        obj.load("figure", name, colorful_color(i), f_size, f_line)
        obj.effect()
      elseif not loaded then
        obj.load("figure", name, col, f_size, f_line)
        obj.effect()
        loaded = true
      end
      local direct = obj.rand(dir - dir_ran / 2, dir + dir_ran / 2, i, 0) * rad
      local k = l * (1 - t) * obj.rand(100 - v_ran, 100, i, 12) / 100
      local x = k * math.cos(direct) + obj.rand(-x_ran / 2, x_ran / 2, i, 1)
      local y = k * math.sin(direct) + obj.rand(-y_ran / 2, y_ran / 2, i, 2)
      local zoom = 1 + sv / 100 * (1 - t) - obj.rand(0, s_ran, i, 10) / 100
      local alpha = 1 - av / 100 * (1 - t)
      local rz = obj.rand(-rz_ran / 2, rz_ran / 2, i, 6) + obj.rand(-rzv_ran / 2, rzv_ran / 2, i, 9) * time
      obj.draw(x, y, 0, zoom, alpha, 0, 0, rz)
      drawn = true
    end
  end
end

-- 見える粒が 1 つも無いフレームは何も描かない（原作も透明な粒しか描いていない）
if not drawn then
  obj.setoption("draw_state", true)
end
