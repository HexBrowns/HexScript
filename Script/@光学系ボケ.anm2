@玉ボケ
--information:玉ボケ@光学系ボケ v1.02 by HexBrowns
--label:HexScript
--filter
--track@radius:ボケ半径,0,200,30,0.1
--track@threshold:輝度閾値,0,100,70,0.01
--track@edge_str:エッジ強度,0,100,50,0.01
--track@strength:強さ,0,1000,100,1
--select@shape:形状,円=0,六角形=1,八角形=2
--check@add_blend:加算合成,true

-- [1] ハイライト抽出
--[[pixelshader@highlight_extract:
Texture2D src : register(t0);
cbuffer constant0 : register(b0) {
    float cb_threshold;
    float cb_smooth_w;
    float2 cb_pad0;
};

float4 highlight_extract(float4 pos : SV_Position) : SV_Target
{
    const int2   xy  = int2(floor(pos.xy));
    const float4 col = src.Load(int3(xy, 0));
    if (col.a < 0.0001) return float4(0, 0, 0, 0);
    const float3 linear_rgb = col.rgb / col.a;
    const float  lum  = dot(linear_rgb, float3(0.299, 0.587, 0.114));
    const float  mask = smoothstep(cb_threshold - cb_smooth_w, cb_threshold, lum);
    return col * mask;
}
]]

-- [2] ディスクカーネルブラー（非正規化 / パディング対応）
--     acc をそのまま返すことで輝点が丸い玉として広がる
--     登録名はファイル全体で共有されるので、セクションごとに固有の名前にする（v1.01。
--     v1.00 は 3 セクションが別の中身のまま同じ diskblur を定義していた）
--     出力は元の画像を (cb_offset_x, cb_offset_y) だけ内側に置いた大きさ。重みで割らないので、
--     画像の外のタップは足さないだけでよい（透明として数えるのと同じ）
--[[pixelshader@tama_diskblur:
Texture2D src : register(t0);
cbuffer constant0 : register(b0) {
    float cb_radius;
    float cb_edge_str;
    float cb_shape;
    float cb_pad_x;
    float cb_src_w;
    float cb_src_h;
    float cb_offset_x;
    float cb_offset_y;
};

bool dskb_hex(float dx, float dy, float r)
{
    const float ax = abs(dx), ay = abs(dy);
    return (ax <= r) && (ax * 0.5 + ay * 0.866025 <= r);
}
bool dskb_oct(float dx, float dy, float r)
{
    const float ax = abs(dx), ay = abs(dy);
    return (ax <= r) && (ay <= r) && ((ax + ay) * 0.707107 <= r);
}

float4 tama_diskblur(float4 pos : SV_Position) : SV_Target
{
    const int2 off    = int2(int(cb_offset_x), int(cb_offset_y));
    const int  wmax   = int(cb_src_w) - 1;
    const int  hmax   = int(cb_src_h) - 1;
    const int  r_int  = int(ceil(cb_radius));
    const int  ishape = int(cb_shape + 0.5);
    const int2 xy     = int2(floor(pos.xy)) - off;

    float4 acc = float4(0, 0, 0, 0);

    [loop]
    for (int dy = -r_int; dy <= r_int; dy++)
    {
        [loop]
        for (int dx = -r_int; dx <= r_int; dx++)
        {
            const float fdx = float(dx), fdy = float(dy);
            const float dist = length(float2(fdx, fdy));

            bool inside;
            [branch]
            if      (ishape == 2) inside = dskb_oct(fdx, fdy, cb_radius);
            else if (ishape == 1) inside = dskb_hex(fdx, fdy, cb_radius);
            else                  inside = (dist <= cb_radius);

            [branch]
            if (!inside) continue;

            const int sx = xy.x + dx;
            const int sy = xy.y + dy;
            [branch]
            if (sx < 0 || sy < 0 || sx > wmax || sy > hmax) continue;

            const float n = (cb_radius > 0.0001) ? dist / cb_radius : 0.0;
            const float w = 1.0 + cb_edge_str * smoothstep(0.7, 1.0, n);
            acc += src.Load(int3(sx, sy, 0)) * w;
        }
    }
    return acc;
}
]]

-- [3] 加算 / 通常合成
--     v1.02: 出力（object）は玉と同じ大きさに広げてある。元の画像は (cb_offset_x, cb_offset_y) だけ
--     内側にあり、その外は透明として読む
--[[pixelshader@blend_add:
Texture2D base_tex  : register(t0);
Texture2D bokeh_tex : register(t1);
cbuffer constant0 : register(b0) {
    float cb_strength;
    float cb_add_blend;
    float cb_offset_x;
    float cb_offset_y;
    float cb_src_w;
    float cb_src_h;
    float2 cb_pad0;
};

// v1.01: 乗算済みのまま α が 1 を超えないようにする。
//   玉の α は「強さ × 覆った割合 × 縁の重み」なので 1 を超える（既定値でも不透明な部分で約 2）。
//   v1.00 は加算で base.a + bokeh.a をそのまま返し、通常では base * (1 - bokeh.a) が負になっていた。
//   α が 1 を超えた画像を重ねると、下の画像に (1 - α) < 0 が掛かって色が引かれる。
float4 blend_add(float4 pos : SV_Position) : SV_Target
{
    const int2   xy    = int2(floor(pos.xy));
    const int2   sxy   = xy - int2(int(cb_offset_x), int(cb_offset_y));
    float4 base = float4(0, 0, 0, 0);
    [branch]
    if (sxy.x >= 0 && sxy.y >= 0 && sxy.x < int(cb_src_w) && sxy.y < int(cb_src_h))
        base = base_tex.Load(int3(sxy, 0));
    float4 bokeh = bokeh_tex.Load(int3(xy, 0)) * cb_strength;
    float4 result = base + bokeh;
    [branch]
    if (cb_add_blend > 0.5)
    {
        // 加算: 色は足したまま（明るくなる分は残す）、α だけ 1 で止める
        result.a = min(result.a, 1.0);
    }
    else
    {
        // 通常: 玉の α が 1 を超えたら色ごと α で割って 1 に揃える（玉のストレートの色は変えない）
        bokeh  = bokeh / max(bokeh.a, 1.0);
        result = base * (1.0 - bokeh.a) + bokeh;
    }
    return result;
}
]]

-- Lua (@玉ボケ)
local obj, math = obj, math

if radius    <= 0   then return end
if threshold >= 100 then return end
if strength  <= 0   then return end

-- v1.02: ぼけがオブジェクトの外枠で切れないよう、各辺を広げる量を決める
--   正本。@レンズぼかし / @チルトシフト / @球面収差ボケ の plan_pad は同じ複製（変更時は 4 つとも直す）
--   - フィルタオブジェクトは大きさを変えられないので広げない（ルール au2-filter-object）
--   - 上下・左右を同じだけ広げるので、元の画像は同じ位置に残る（中心はずれない）
--   - 広げた画像は image_max に収める。cache と tempbuffer は合わせて 1600 万ドットの枠を共有し、
--     超えると最も長く使っていないものから黙って捨てられるので、広げた tempbuffer と
--     元の大きさの cache（keep 枚）の合計が CACHE_BUDGET を超えない所まで縮める
--     （縮めても玉の半径は変えない。切れる位置が内側へ寄るだけ）
local CACHE_BUDGET = 15000000
local is_filter = obj.getinfo("filter")
is_filter = (is_filter == true or is_filter == 1)
local function plan_pad(want, w, h, keep)
  if is_filter then return 0, 0 end
  local max_w, max_h = obj.getinfo("image_max")
  local cap_x = math.max(0, math.floor(((max_w or w) - w) / 2))
  local cap_y = math.max(0, math.floor(((max_h or h) - h) / 2))
  for p = want, 1, -1 do
    local px, py = math.min(p, cap_x), math.min(p, cap_y)
    if keep * w * h + (w + 2 * px) * (h + 2 * py) <= CACHE_BUDGET then return px, py end
  end
  return 0, 0
end

local thresh   = threshold / 100
local smooth_w = 0.05
local edge     = edge_str / 100
local shape_v  = shape * 1.0
local add_f    = add_blend and 1.0 or 0.0
local W        = obj.w
local H        = obj.h
local pad_x, pad_y = plan_pad(math.ceil(radius), W, H, 2)
local Wbig     = W + 2 * pad_x
local Hbig     = H + 2 * pad_y
local disk_area = math.max(math.pi * radius * radius, 1.0)
local str = (strength / 100) / disk_area

obj.copybuffer("cache:tama_orig", "object")
obj.copybuffer("tempbuffer",      "object")
obj.pixelshader("highlight_extract", "tempbuffer", "object",
    { thresh, smooth_w, 0.0, 0.0 })
obj.copybuffer("cache:tama_hi", "tempbuffer")
if pad_x > 0 or pad_y > 0 then
  -- 中身は blend_add で全部描き直すので、広げた部分の塗りは何でもよい
  obj.effect("領域拡張", "上", pad_y, "下", pad_y, "左", pad_x, "右", pad_x, "塗りつぶし", 0)
end
obj.clearbuffer("tempbuffer", Wbig, Hbig)
obj.pixelshader("tama_diskblur", "tempbuffer", "cache:tama_hi",
    { radius, edge, shape_v, 0.0, W * 1.0, H * 1.0, pad_x * 1.0, pad_y * 1.0 })
obj.pixelshader("blend_add", "object", { "cache:tama_orig", "tempbuffer" },
    { str, add_f, pad_x * 1.0, pad_y * 1.0, W * 1.0, H * 1.0, 0.0, 0.0 })


@レンズぼかし
--information:レンズぼかし@光学系ボケ v1.02 by HexBrowns
--label:HexScript
--filter
--track@radius:ボケ半径,0,200,30,0.1
--track@strength:強さ,0,100,100,0.01
--select@shape:形状,円=0,六角形=1,八角形=2

-- [1] ディスクカーネルブラー（正規化 / パディング対応）
--     acc / weight_sum で実カメラのボケに近い畳み込み平均
--     正本。@チルトシフト の tilt_diskblur は名前以外同じ複製（変更時は両方を直す）
--     出力は元の画像を (cb_offset_x, cb_offset_y) だけ内側に置いた大きさ
--[[pixelshader@lens_diskblur:
Texture2D src : register(t0);
cbuffer constant0 : register(b0) {
    float cb_radius;
    float cb_edge_str;
    float cb_shape;
    float cb_count_out;
    float cb_src_w;
    float cb_src_h;
    float cb_offset_x;
    float cb_offset_y;
};

bool dskb_hex(float dx, float dy, float r)
{
    const float ax = abs(dx), ay = abs(dy);
    return (ax <= r) && (ax * 0.5 + ay * 0.866025 <= r);
}
bool dskb_oct(float dx, float dy, float r)
{
    const float ax = abs(dx), ay = abs(dy);
    return (ax <= r) && (ay <= r) && ((ax + ay) * 0.707107 <= r);
}

float4 lens_diskblur(float4 pos : SV_Position) : SV_Target
{
    const int2 off    = int2(int(cb_offset_x), int(cb_offset_y));
    const int  wmax   = int(cb_src_w) - 1;
    const int  hmax   = int(cb_src_h) - 1;
    const int  r_int  = int(ceil(cb_radius));
    const int  ishape = int(cb_shape + 0.5);
    const bool count_out = (cb_count_out > 0.5);
    const int2 xy     = int2(floor(pos.xy)) - off;

    float4 acc = float4(0, 0, 0, 0);
    float  ws  = 0.0;

    [loop]
    for (int dy = -r_int; dy <= r_int; dy++)
    {
        [loop]
        for (int dx = -r_int; dx <= r_int; dx++)
        {
            const float fdx = float(dx), fdy = float(dy);
            const float dist = length(float2(fdx, fdy));

            bool inside;
            [branch]
            if      (ishape == 2) inside = dskb_oct(fdx, fdy, cb_radius);
            else if (ishape == 1) inside = dskb_hex(fdx, fdy, cb_radius);
            else                  inside = (dist <= cb_radius);

            [branch]
            if (!inside) continue;

            const int  sx     = xy.x + dx;
            const int  sy     = xy.y + dy;
            const bool in_src = (sx >= 0 && sy >= 0 && sx <= wmax && sy <= hmax);
            // v1.02: 通常のオブジェクト（count_out）では、画像の外のタップも透明として重みに数える。
            //   数えないと外枠の外側が内側だけの平均になり、フェードせず不透明のまま膨らむ。
            //   フィルタオブジェクトでは数えない（v1.01 と同じ。画面の縁を透明に寄せない）
            [branch]
            if (!in_src && !count_out) continue;

            const float n = (cb_radius > 0.0001) ? dist / cb_radius : 0.0;
            const float w = 1.0 + cb_edge_str * smoothstep(0.7, 1.0, n);
            [branch]
            if (in_src) acc += src.Load(int3(sx, sy, 0)) * w;
            ws  += w;
        }
    }
    if (ws < 0.0001) return float4(0, 0, 0, 0);
    return acc / ws;
}
]]

-- [2] lerp 合成
--     正本。@球面収差ボケ の sa_blend_lerp は名前以外同じ複製（変更時は両方を直す）
--     v1.02: 出力（object）はぼけと同じ大きさに広げてある。元の画像は (cb_offset_x, cb_offset_y) だけ
--     内側にあり、その外は透明として読む
--[[pixelshader@lens_blend_lerp:
Texture2D base_tex : register(t0);
Texture2D blur_tex : register(t1);
cbuffer constant0 : register(b0) {
    float cb_strength;
    float cb_offset_x;
    float cb_offset_y;
    float cb_src_w;
    float cb_src_h;
    float3 cb_pad0;
};

float4 lens_blend_lerp(float4 pos : SV_Position) : SV_Target
{
    const int2   xy   = int2(floor(pos.xy));
    const int2   sxy  = xy - int2(int(cb_offset_x), int(cb_offset_y));
    float4 base = float4(0, 0, 0, 0);
    [branch]
    if (sxy.x >= 0 && sxy.y >= 0 && sxy.x < int(cb_src_w) && sxy.y < int(cb_src_h))
        base = base_tex.Load(int3(sxy, 0));
    const float4 blur = blur_tex.Load(int3(xy, 0));
    return lerp(base, blur, saturate(cb_strength));
}
]]

-- Lua (@レンズぼかし)
local obj, math = obj, math

if radius   <= 0 then return end
if strength <= 0 then return end

-- 正本: @玉ボケ の plan_pad（同じ複製。変更時は 4 つとも直す）
local CACHE_BUDGET = 15000000
local is_filter = obj.getinfo("filter")
is_filter = (is_filter == true or is_filter == 1)
local function plan_pad(want, w, h, keep)
  if is_filter then return 0, 0 end
  local max_w, max_h = obj.getinfo("image_max")
  local cap_x = math.max(0, math.floor(((max_w or w) - w) / 2))
  local cap_y = math.max(0, math.floor(((max_h or h) - h) / 2))
  for p = want, 1, -1 do
    local px, py = math.min(p, cap_x), math.min(p, cap_y)
    if keep * w * h + (w + 2 * px) * (h + 2 * py) <= CACHE_BUDGET then return px, py end
  end
  return 0, 0
end

local str     = strength / 100
local shape_v = shape * 1.0
local W       = obj.w
local H       = obj.h
local pad_x, pad_y = plan_pad(math.ceil(radius), W, H, 1)
local Wbig    = W + 2 * pad_x
local Hbig    = H + 2 * pad_y
local count_out = is_filter and 0.0 or 1.0

obj.copybuffer("cache:lens_orig", "object")
if pad_x > 0 or pad_y > 0 then
  -- 中身は lens_blend_lerp で全部描き直すので、広げた部分の塗りは何でもよい
  obj.effect("領域拡張", "上", pad_y, "下", pad_y, "左", pad_x, "右", pad_x, "塗りつぶし", 0)
end
obj.clearbuffer("tempbuffer", Wbig, Hbig)
obj.pixelshader("lens_diskblur", "tempbuffer", "cache:lens_orig",
    { radius, 0.0, shape_v, count_out, W * 1.0, H * 1.0, pad_x * 1.0, pad_y * 1.0 })
obj.pixelshader("lens_blend_lerp", "object", { "cache:lens_orig", "tempbuffer" },
    { str, pad_x * 1.0, pad_y * 1.0, W * 1.0, H * 1.0, 0.0, 0.0, 0.0 })


@チルトシフト
--information:チルトシフト@光学系ボケ v1.02 by HexBrowns
--label:HexScript
--filter
--track@radius:ボケ半径,0,200,30,0.1
--track@focus_y:焦点位置,0,100,50,0.1
--track@focus_w:焦点幅,0,2000,200,1
--track@focus_edge:グラデ幅,0,1000,150,1
--track@strength:強さ,0,100,100,0.01
--select@direction:方向,縦=0,横=1

-- [1] ディスクカーネルブラー（正規化 / パディング対応）
--     正本: @レンズぼかし の lens_diskblur（名前以外同じ。変更時は両方を直す）
--[[pixelshader@tilt_diskblur:
Texture2D src : register(t0);
cbuffer constant0 : register(b0) {
    float cb_radius;
    float cb_edge_str;
    float cb_shape;
    float cb_count_out;
    float cb_src_w;
    float cb_src_h;
    float cb_offset_x;
    float cb_offset_y;
};

bool dskb_hex(float dx, float dy, float r)
{
    const float ax = abs(dx), ay = abs(dy);
    return (ax <= r) && (ax * 0.5 + ay * 0.866025 <= r);
}
bool dskb_oct(float dx, float dy, float r)
{
    const float ax = abs(dx), ay = abs(dy);
    return (ax <= r) && (ay <= r) && ((ax + ay) * 0.707107 <= r);
}

float4 tilt_diskblur(float4 pos : SV_Position) : SV_Target
{
    const int2 off    = int2(int(cb_offset_x), int(cb_offset_y));
    const int  wmax   = int(cb_src_w) - 1;
    const int  hmax   = int(cb_src_h) - 1;
    const int  r_int  = int(ceil(cb_radius));
    const int  ishape = int(cb_shape + 0.5);
    const bool count_out = (cb_count_out > 0.5);
    const int2 xy     = int2(floor(pos.xy)) - off;

    float4 acc = float4(0, 0, 0, 0);
    float  ws  = 0.0;

    [loop]
    for (int dy = -r_int; dy <= r_int; dy++)
    {
        [loop]
        for (int dx = -r_int; dx <= r_int; dx++)
        {
            const float fdx = float(dx), fdy = float(dy);
            const float dist = length(float2(fdx, fdy));

            bool inside;
            [branch]
            if      (ishape == 2) inside = dskb_oct(fdx, fdy, cb_radius);
            else if (ishape == 1) inside = dskb_hex(fdx, fdy, cb_radius);
            else                  inside = (dist <= cb_radius);

            [branch]
            if (!inside) continue;

            const int  sx     = xy.x + dx;
            const int  sy     = xy.y + dy;
            const bool in_src = (sx >= 0 && sy >= 0 && sx <= wmax && sy <= hmax);
            // v1.02: 通常のオブジェクト（count_out）では、画像の外のタップも透明として重みに数える。
            //   数えないと外枠の外側が内側だけの平均になり、フェードせず不透明のまま膨らむ。
            //   フィルタオブジェクトでは数えない（v1.01 と同じ。画面の縁を透明に寄せない）
            [branch]
            if (!in_src && !count_out) continue;

            const float n = (cb_radius > 0.0001) ? dist / cb_radius : 0.0;
            const float w = 1.0 + cb_edge_str * smoothstep(0.7, 1.0, n);
            [branch]
            if (in_src) acc += src.Load(int3(sx, sy, 0)) * w;
            ws  += w;
        }
    }
    if (ws < 0.0001) return float4(0, 0, 0, 0);
    return acc / ws;
}
]]

-- [2] 焦点マスクブレンド
--     v1.02: 出力（object）はぼけと同じ大きさに広げてある。元の画像は (cb_offset_x, cb_offset_y) だけ
--     内側にあり、その外は透明として読む。焦点の位置は元の画像の座標（sxy と cb_src_w / cb_src_h）で測る
--[[pixelshader@tilt_blend:
Texture2D base_tex : register(t0);
Texture2D blur_tex : register(t1);
cbuffer constant0 : register(b0) {
    float cb_focus_y;
    float cb_focus_half;
    float cb_focus_edge;
    float cb_strength;
    float cb_offset_x;
    float cb_offset_y;
    float cb_src_w;
    float cb_src_h;
    float cb_direction;
    float3 cb_pad0;
};

float4 tilt_blend(float4 pos : SV_Position) : SV_Target
{
    const int2   xy   = int2(floor(pos.xy));
    const int2   sxy  = xy - int2(int(cb_offset_x), int(cb_offset_y));
    float4 base = float4(0, 0, 0, 0);
    [branch]
    if (sxy.x >= 0 && sxy.y >= 0 && sxy.x < int(cb_src_w) && sxy.y < int(cb_src_h))
        base = base_tex.Load(int3(sxy, 0));
    const float4 blur = blur_tex.Load(int3(xy, 0));

    const float size   = (cb_direction < 0.5) ? cb_src_h : cb_src_w;
    const float axis   = (cb_direction < 0.5) ? float(sxy.y) : float(sxy.x);
    const float center = cb_focus_y * size;
    const float dist   = abs(axis - center);
    const float edge_w = max(cb_focus_edge, 1.0);
    const float ratio  = smoothstep(cb_focus_half, cb_focus_half + edge_w, dist);

    return lerp(base, blur, saturate(ratio * cb_strength));
}
]]

-- Lua (@チルトシフト)
local obj, math = obj, math

if radius   <= 0 then return end
if strength <= 0 then return end

-- 正本: @玉ボケ の plan_pad（同じ複製。変更時は 4 つとも直す）
local CACHE_BUDGET = 15000000
local is_filter = obj.getinfo("filter")
is_filter = (is_filter == true or is_filter == 1)
local function plan_pad(want, w, h, keep)
  if is_filter then return 0, 0 end
  local max_w, max_h = obj.getinfo("image_max")
  local cap_x = math.max(0, math.floor(((max_w or w) - w) / 2))
  local cap_y = math.max(0, math.floor(((max_h or h) - h) / 2))
  for p = want, 1, -1 do
    local px, py = math.min(p, cap_x), math.min(p, cap_y)
    if keep * w * h + (w + 2 * px) * (h + 2 * py) <= CACHE_BUDGET then return px, py end
  end
  return 0, 0
end

local str        = strength / 100
local W          = obj.w
local H          = obj.h
local pad_x, pad_y = plan_pad(math.ceil(radius), W, H, 1)
local Wbig       = W + 2 * pad_x
local Hbig       = H + 2 * pad_y
local count_out  = is_filter and 0.0 or 1.0
local dir        = direction * 1.0
local focus_y_r  = focus_y / 100
local focus_half = focus_w / 2.0
local focus_edg  = math.max(focus_edge * 1.0, 1.0)

obj.copybuffer("cache:tilt_orig", "object")
if pad_x > 0 or pad_y > 0 then
  -- 中身は tilt_blend で全部描き直すので、広げた部分の塗りは何でもよい
  obj.effect("領域拡張", "上", pad_y, "下", pad_y, "左", pad_x, "右", pad_x, "塗りつぶし", 0)
end
obj.clearbuffer("tempbuffer", Wbig, Hbig)
obj.pixelshader("tilt_diskblur", "tempbuffer", "cache:tilt_orig",
    { radius, 0.0, 0.0, count_out, W * 1.0, H * 1.0, pad_x * 1.0, pad_y * 1.0 })
obj.pixelshader("tilt_blend", "object", { "cache:tilt_orig", "tempbuffer" },
    { focus_y_r, focus_half, focus_edg, str, pad_x * 1.0, pad_y * 1.0, W * 1.0, H * 1.0,
      dir, 0.0, 0.0, 0.0 })


@球面収差ボケ
--information:球面収差ボケ@光学系ボケ v1.02 by HexBrowns
--label:HexScript
--filter
--track@radius:ボケ半径,0,200,20,0.1
--track@ring_str:リング強度,0,100,60,0.01
--track@aberration:色収差,0,100,20,0.01
--track@strength:強さ,0,100,80,0.01

-- [1] RGB 別半径ディスクブラー（正規化 / パディング対応）
--     R: radius×(1+aberration)  G: radius  B: radius×(1-aberration×0.5)
--     ボケ縁部にカラーフリンジが生じ、球面収差特有の色にじみを再現する
--     出力は元の画像を (cb_offset_x, cb_offset_y) だけ内側に置いた大きさ
--[[pixelshader@sa_diskblur:
Texture2D src : register(t0);
cbuffer constant0 : register(b0) {
    float cb_radius;
    float cb_ring_str;
    float cb_aberration;
    float cb_count_out;
    float cb_src_w;
    float cb_src_h;
    float cb_offset_x;
    float cb_offset_y;
};

float4 sa_diskblur(float4 pos : SV_Position) : SV_Target
{
    const int2 off  = int2(int(cb_offset_x), int(cb_offset_y));
    const int  wmax = int(cb_src_w) - 1;
    const int  hmax = int(cb_src_h) - 1;
    const bool count_out = (cb_count_out > 0.5);
    const int2 xy   = int2(floor(pos.xy)) - off;

    const float r_G = cb_radius;
    const float r_R = cb_radius * (1.0 + cb_aberration);
    const float r_B = cb_radius * max(1.0 - cb_aberration * 0.5, 0.01);
    const int   r_max = int(ceil(r_R));

    float4 acc_r = float4(0,0,0,0); float ws_r = 0.0;
    float4 acc_g = float4(0,0,0,0); float ws_g = 0.0;
    float4 acc_b = float4(0,0,0,0); float ws_b = 0.0;

    [loop]
    for (int dy = -r_max; dy <= r_max; dy++)
    {
        [loop]
        for (int dx = -r_max; dx <= r_max; dx++)
        {
            const float dist = length(float2(float(dx), float(dy)));
            const int  sx     = xy.x + dx;
            const int  sy     = xy.y + dy;
            const bool in_src = (sx >= 0 && sy >= 0 && sx <= wmax && sy <= hmax);
            // v1.02: 通常のオブジェクト（count_out）では、画像の外のタップも透明として重みに数える
            //   （@レンズぼかし の lens_diskblur と同じ理由）
            [branch]
            if (!in_src && !count_out) continue;
            float4 s = float4(0, 0, 0, 0);
            [branch]
            if (in_src) s = src.Load(int3(sx, sy, 0));
            [branch]
            if (dist <= r_R) {
                const float w = 1.0 + cb_ring_str * smoothstep(0.7, 1.0, dist / r_R);
                acc_r += s * w; ws_r += w;
            }
            [branch]
            if (dist <= r_G) {
                const float w = 1.0 + cb_ring_str * smoothstep(0.7, 1.0, dist / r_G);
                acc_g += s * w; ws_g += w;
            }
            [branch]
            if (dist <= r_B) {
                const float w = 1.0 + cb_ring_str * smoothstep(0.7, 1.0, dist / r_B);
                acc_b += s * w; ws_b += w;
            }
        }
    }

    if (ws_g < 0.0001) return float4(0, 0, 0, 0);
    const float r = (ws_r > 0.0001) ? acc_r.r / ws_r : 0.0;
    const float g = acc_g.g / ws_g;
    const float b = (ws_b > 0.0001) ? acc_b.b / ws_b : 0.0;
    const float a = acc_g.a / ws_g;
    return float4(r, g, b, a);
}
]]

-- [2] lerp 合成
--     正本: @レンズぼかし の lens_blend_lerp（名前以外同じ。変更時は両方を直す）
--[[pixelshader@sa_blend_lerp:
Texture2D base_tex : register(t0);
Texture2D blur_tex : register(t1);
cbuffer constant0 : register(b0) {
    float cb_strength;
    float cb_offset_x;
    float cb_offset_y;
    float cb_src_w;
    float cb_src_h;
    float3 cb_pad0;
};

float4 sa_blend_lerp(float4 pos : SV_Position) : SV_Target
{
    const int2   xy   = int2(floor(pos.xy));
    const int2   sxy  = xy - int2(int(cb_offset_x), int(cb_offset_y));
    float4 base = float4(0, 0, 0, 0);
    [branch]
    if (sxy.x >= 0 && sxy.y >= 0 && sxy.x < int(cb_src_w) && sxy.y < int(cb_src_h))
        base = base_tex.Load(int3(sxy, 0));
    const float4 blur = blur_tex.Load(int3(xy, 0));
    return lerp(base, blur, saturate(cb_strength));
}
]]

-- Lua (@球面収差ボケ)
local obj, math = obj, math

if radius   <= 0 then return end
if strength <= 0 then return end

-- 正本: @玉ボケ の plan_pad（同じ複製。変更時は 4 つとも直す）
local CACHE_BUDGET = 15000000
local is_filter = obj.getinfo("filter")
is_filter = (is_filter == true or is_filter == 1)
local function plan_pad(want, w, h, keep)
  if is_filter then return 0, 0 end
  local max_w, max_h = obj.getinfo("image_max")
  local cap_x = math.max(0, math.floor(((max_w or w) - w) / 2))
  local cap_y = math.max(0, math.floor(((max_h or h) - h) / 2))
  for p = want, 1, -1 do
    local px, py = math.min(p, cap_x), math.min(p, cap_y)
    if keep * w * h + (w + 2 * px) * (h + 2 * py) <= CACHE_BUDGET then return px, py end
  end
  return 0, 0
end

local str      = strength / 100
local ring     = ring_str / 100
local aber     = aberration / 100
local W        = obj.w
local H        = obj.h
local radius_r = radius * (1.0 + aber)
local pad_x, pad_y = plan_pad(math.ceil(radius_r), W, H, 1)
local Wbig     = W + 2 * pad_x
local Hbig     = H + 2 * pad_y
local count_out = is_filter and 0.0 or 1.0

obj.copybuffer("cache:sa_orig", "object")
if pad_x > 0 or pad_y > 0 then
  -- 中身は sa_blend_lerp で全部描き直すので、広げた部分の塗りは何でもよい
  obj.effect("領域拡張", "上", pad_y, "下", pad_y, "左", pad_x, "右", pad_x, "塗りつぶし", 0)
end
obj.clearbuffer("tempbuffer", Wbig, Hbig)
obj.pixelshader("sa_diskblur", "tempbuffer", "cache:sa_orig",
    { radius, ring, aber, count_out, W * 1.0, H * 1.0, pad_x * 1.0, pad_y * 1.0 })
obj.pixelshader("sa_blend_lerp", "object", { "cache:sa_orig", "tempbuffer" },
    { str, pad_x * 1.0, pad_y * 1.0, W * 1.0, H * 1.0, 0.0, 0.0, 0.0 })

@マップぼかし
--information:マップぼかし@光学系ボケ v1.00 by HexBrowns
--label:HexScript
--filter
--track@radius:最大ボケ半径,0,200,30,0.1
--select@shape:形状=0,ガウス=0,円=1,六角形=2,八角形=3
--select@map_mode:マップ=0,自分の明るさ=0,自分のアルファ=1,レイヤー=2
--track@map_layer:マップのレイヤー,1,1000,1,1
--hide@map_layer:map_mode<2
--check@map_fx:マップの効果を適用,true
--hide@map_fx:map_mode<2
--select@map_fit:マップの合わせ方=0,伸ばす=0,中央に置く=1
--hide@map_fit:map_mode<2
--track@black_pt:黒の点,0,100,0,0.1
--track@white_pt:白の点,0,100,100,0.1
--check@invert:マップを反転,false
--select@quality:品質=0,標準=0,高=1

-- マップ（自分の明るさ・アルファ、または別のレイヤー）の値に応じて、画素ごとにぼかしの量を変える
-- （After Effects の「ブラー（合成）」に近い）。白いほど強く、黒いほど弱い。マップの値 v は
-- 黒の点〜白の点で 0〜1 の t に写し（反転なら 1 - t）、t x 最大ボケ半径 でぼかす。
--   ガウス      : 半径 R に対して σ = R / 2（円の半径 R と同じ分散）。σ を 2 倍ずつ変えた段を縮小して作り、
--                 画素の σ を挟む 2 段を「分散がちょうど σ^2 になる重み」で混ぜる。σ <= 1 の所は元の画像を
--                 直接ガウスで集める（段を持たない）
--   円 / 六角形 / 八角形 : 画素ごとの半径の中を格子状に集めて平均する（形は @玉ボケ の dskb_hex / dskb_oct と同じ）。
--                 格子の間隔が 1 画素を超える所は、隙間を埋める分だけ段でぼかしてから集める
-- 仕様: AI/specifications/20261012_光学系ボケ_マップぼかし_spec.md
-- 机上検証: AI/scripts/光学系ボケ/verify_map_blur.py

-- [1] マップの値を t（0〜1）にする。出力は元の画像と同じ大きさで、r に t を入れる
--     マップは乗算済みのまま読む（明るさは黒の上に置いた明るさ。透明な所は 0）
--     伸ばす: マップの大きさが違っても出力の大きさに引き伸ばす / 中央に置く: 等倍で中央に置き、外は 0
--[[pixelshader@mbl_map:
Texture2D map_tex : register(t0);
SamplerState smp : register(s0);
cbuffer constant0 : register(b0) {
    float2 cb_out_size;
    float2 cb_map_size;
    float cb_mode;
    float cb_fit;
    float cb_black;
    float cb_white;
    float cb_invert;
};

float4 mbl_map(float4 pos : SV_Position) : SV_Target
{
    float4 m = float4(0, 0, 0, 0);
    [branch]
    if (cb_fit < 0.5)
    {
        m = map_tex.SampleLevel(smp, pos.xy / cb_out_size, 0);
    }
    else
    {
        const int2 mxy = int2(floor(pos.xy - (cb_out_size - cb_map_size) * 0.5));
        [branch]
        if (mxy.x >= 0 && mxy.y >= 0 && mxy.x < int(cb_map_size.x) && mxy.y < int(cb_map_size.y))
            m = map_tex.Load(int3(mxy, 0));
    }
    const float v    = (cb_mode > 0.5) ? m.a : dot(m.rgb, float3(0.2126, 0.7152, 0.0722));
    const float span = cb_white - cb_black;
    float t = 0.0;
    [branch]
    if (abs(span) < 0.00001) t = (v >= cb_black) ? 1.0 : 0.0;
    else                     t = saturate((v - cb_black) / span);
    [branch]
    if (cb_invert > 0.5) t = 1.0 - t;
    return float4(t, t, t, 1.0);
}
]]

-- [2] 段を作る 1 方向のガウス（横と縦の 2 回で 1 段）
--     座標は「広げた画像の画素」（元の画素）で数える。出力の 1 画素は cb_out_d 画素を覆い、入力は
--     cb_in_org を左上にして 1 画素が (1 / cb_in_scale / 入力の大きさ) 画素を覆う。入力は sampler で
--     バイリニアに読む（通常のオブジェクトは範囲外を透明、フィルタオブジェクトは端の色）
--[[pixelshader@mbl_gauss:
Texture2D src : register(t0);
SamplerState smp : register(s0);
cbuffer constant0 : register(b0) {
    float2 cb_out_d;
    float2 cb_in_scale;
    float2 cb_in_org;
    float2 cb_dir;
    float cb_tap_step;
    float cb_taps;
    float cb_var;
};

float4 mbl_gauss(float4 pos : SV_Position) : SV_Target
{
    const float2 full = pos.xy * cb_out_d;
    const int    n    = int(cb_taps + 0.5);
    float4 acc = float4(0, 0, 0, 0);
    float  ws  = 0.0;
    [loop]
    for (int i = -n; i <= n; i++)
    {
        const float x = float(i) * cb_tap_step;
        const float w = (cb_var > 0.000001) ? exp(-0.5 * x * x / cb_var) : ((i == 0) ? 1.0 : 0.0);
        acc += src.SampleLevel(smp, (full + cb_dir * x - cb_in_org) * cb_in_scale, 0) * w;
        ws  += w;
    }
    return acc / max(ws, 0.000001);
}
]]

-- [3] ガウスの合成。t（マップ）から σ を決め、σ を挟む 2 段を分散で混ぜる
--     段 k の σ は cb_sig_top x 2^(k - 段の数)。段 0 は元の画像を σ0 = cb_sig_top x 2^(-段の数) で直接集めたもの
--     マップは元の画像の大きさなので、広げた所は端の値で読む（ぼけのはみ出しが t の端の値で続く）
--     正本: mbl_lv はこの mbl_gauss_mix のもの。mbl_lens_mix に名前以外同じ複製がある（変更時は両方を直す）
--[[pixelshader@mbl_gauss_mix:
Texture2D src_tex : register(t0);
Texture2D map_tex : register(t1);
Texture2D lv1 : register(t2);
Texture2D lv2 : register(t3);
Texture2D lv3 : register(t4);
Texture2D lv4 : register(t5);
Texture2D lv5 : register(t6);
Texture2D lv6 : register(t7);
Texture2D lv7 : register(t8);
SamplerState smp : register(s0);
cbuffer constant0 : register(b0) {
    float2 cb_pad;
    float2 cb_src_size;
    float2 cb_ext1;
    float2 cb_ext2;
    float2 cb_ext3;
    float2 cb_ext4;
    float2 cb_ext5;
    float2 cb_ext6;
    float2 cb_ext7;
    float cb_sig_top;
    float cb_levels;
    float cb_sig_max;
    float cb_count_out;
    float cb_shape;
    float cb_taps_m;
};

float4 mbl_lv(int k, float2 full)
{
    float4 c = float4(0, 0, 0, 0);
    [branch]
    if      (k <= 0) c = src_tex.SampleLevel(smp, (full - cb_pad) / cb_src_size, 0);
    else if (k == 1) c = lv1.SampleLevel(smp, full * cb_ext1, 0);
    else if (k == 2) c = lv2.SampleLevel(smp, full * cb_ext2, 0);
    else if (k == 3) c = lv3.SampleLevel(smp, full * cb_ext3, 0);
    else if (k == 4) c = lv4.SampleLevel(smp, full * cb_ext4, 0);
    else if (k == 5) c = lv5.SampleLevel(smp, full * cb_ext5, 0);
    else if (k == 6) c = lv6.SampleLevel(smp, full * cb_ext6, 0);
    else             c = lv7.SampleLevel(smp, full * cb_ext7, 0);
    return c;
}

float4 mbl_gauss_mix(float4 pos : SV_Position) : SV_Target
{
    const float2 full = pos.xy;
    const int2   smax = int2(cb_src_size) - int2(1, 1);
    const int2   cxy  = int2(floor(full - cb_pad));
    const float  t    = map_tex.Load(int3(clamp(cxy, int2(0, 0), smax), 0)).r;
    const float  sig  = t * cb_sig_max;
    const int    nlv  = int(cb_levels + 0.5);
    const float  sig0 = (nlv > 0) ? cb_sig_top * exp2(-float(nlv)) : cb_sig_top;

    float4 a = float4(0, 0, 0, 0);
    float4 b = float4(0, 0, 0, 0);
    float  w = 0.0;
    [branch]
    if (nlv <= 1 || sig <= sig0 * 2.0)
    {
        // 段 0（直接集める）。σ0 を超えたら段 1（σ1 = 2 x σ0）と混ぜる。段が 1 つなら σ は σ1 を超えない
        const float gs = min(sig, sig0);
        [branch]
        if (gs < 0.05)
        {
            const bool in_c = (cxy.x >= 0 && cxy.y >= 0 && cxy.x <= smax.x && cxy.y <= smax.y);
            [branch]
            if (in_c || cb_count_out < 0.5) a = src_tex.Load(int3(clamp(cxy, int2(0, 0), smax), 0));
        }
        else
        {
            const int   gr  = int(ceil(3.0 * gs));
            const float inv = 0.5 / (gs * gs);
            float4 acc = float4(0, 0, 0, 0);
            float  ws  = 0.0;
            [loop]
            for (int dy = -gr; dy <= gr; dy++)
            {
                [loop]
                for (int dx = -gr; dx <= gr; dx++)
                {
                    const float wt = exp(-float(dx * dx + dy * dy) * inv);
                    const int2  p  = cxy + int2(dx, dy);
                    const bool  in_src = (p.x >= 0 && p.y >= 0 && p.x <= smax.x && p.y <= smax.y);
                    // 通常のオブジェクトでは画像の外を透明として重みに数える（@レンズぼかし と同じ）。
                    // フィルタオブジェクトでは端の画素で埋める
                    [branch]
                    if (in_src || cb_count_out < 0.5) acc += src_tex.Load(int3(clamp(p, int2(0, 0), smax), 0)) * wt;
                    ws += wt;
                }
            }
            a = acc / max(ws, 0.000001);
        }
        [branch]
        if (nlv > 0 && sig > sig0)
        {
            b = mbl_lv(1, full);
            w = (sig * sig - sig0 * sig0) / (3.0 * sig0 * sig0);
        }
    }
    else
    {
        const int   k  = clamp(int(ceil(log2(sig / sig0))), 2, nlv);
        const float sa = sig0 * exp2(float(k - 1));
        a = mbl_lv(k - 1, full);
        b = mbl_lv(k, full);
        w = (sig * sig - sa * sa) / (3.0 * sa * sa);
    }
    return lerp(a, b, saturate(w));
}
]]

-- [4] 円 / 六角形 / 八角形の合成。半径 r = t x 最大ボケ半径 の形の中を、間隔 s = max(1, r / cb_taps_m) の
--     格子で集めて平均する。形の縁は格子の間隔で覆う割合にする（r が変わっても段差が出ない）。
--     s > 1 の所は、隙間を埋める σ^2 = (s^2 - 1) / 4 だけぼかした絵（段 0 は元の画像）から読む
--     正本: mbl_lv は mbl_gauss_mix のもの（名前以外同じ。変更時は両方を直す）
--[[pixelshader@mbl_lens_mix:
Texture2D src_tex : register(t0);
Texture2D map_tex : register(t1);
Texture2D lv1 : register(t2);
Texture2D lv2 : register(t3);
Texture2D lv3 : register(t4);
Texture2D lv4 : register(t5);
Texture2D lv5 : register(t6);
Texture2D lv6 : register(t7);
Texture2D lv7 : register(t8);
SamplerState smp : register(s0);
cbuffer constant0 : register(b0) {
    float2 cb_pad;
    float2 cb_src_size;
    float2 cb_ext1;
    float2 cb_ext2;
    float2 cb_ext3;
    float2 cb_ext4;
    float2 cb_ext5;
    float2 cb_ext6;
    float2 cb_ext7;
    float cb_sig_top;
    float cb_levels;
    float cb_sig_max;
    float cb_count_out;
    float cb_shape;
    float cb_taps_m;
};

float4 mbl_lv(int k, float2 full)
{
    float4 c = float4(0, 0, 0, 0);
    [branch]
    if      (k <= 0) c = src_tex.SampleLevel(smp, (full - cb_pad) / cb_src_size, 0);
    else if (k == 1) c = lv1.SampleLevel(smp, full * cb_ext1, 0);
    else if (k == 2) c = lv2.SampleLevel(smp, full * cb_ext2, 0);
    else if (k == 3) c = lv3.SampleLevel(smp, full * cb_ext3, 0);
    else if (k == 4) c = lv4.SampleLevel(smp, full * cb_ext4, 0);
    else if (k == 5) c = lv5.SampleLevel(smp, full * cb_ext5, 0);
    else if (k == 6) c = lv6.SampleLevel(smp, full * cb_ext6, 0);
    else             c = lv7.SampleLevel(smp, full * cb_ext7, 0);
    return c;
}

float4 mbl_lens_mix(float4 pos : SV_Position) : SV_Target
{
    const float2 full = pos.xy;
    const int2   smax = int2(cb_src_size) - int2(1, 1);
    const int2   cxy  = int2(floor(full - cb_pad));
    const float  t    = map_tex.Load(int3(clamp(cxy, int2(0, 0), smax), 0)).r;
    const float  r    = t * cb_sig_max;
    const int    ishape = int(cb_shape + 0.5);
    const int    nlv  = int(cb_levels + 0.5);

    [branch]
    if (r < 0.5)
    {
        // 中心の 1 画素だけ（集めても同じ）
        float4 c0 = float4(0, 0, 0, 0);
        const bool in_c = (cxy.x >= 0 && cxy.y >= 0 && cxy.x <= smax.x && cxy.y <= smax.y);
        [branch]
        if (in_c || cb_count_out < 0.5) c0 = src_tex.Load(int3(clamp(cxy, int2(0, 0), smax), 0));
        return c0;
    }

    const float s    = max(1.0, r / cb_taps_m);
    const int   n    = int(ceil(r / s + 0.5));
    const float pre2 = 0.25 * (s * s - 1.0);

    // 隙間を埋める前ぼかしの 2 段（ka と kb を wl で混ぜる。段 0 は元の画像で σ = 0）
    int   ka = 0;
    int   kb = 0;
    float wl = 0.0;
    [branch]
    if (nlv > 0 && pre2 > 0.0)
    {
        const float s1 = cb_sig_top * exp2(1.0 - float(nlv));
        [branch]
        if (pre2 <= s1 * s1)
        {
            kb = 1;
            wl = pre2 / (s1 * s1);
        }
        else
        {
            const int   k  = clamp(int(ceil(0.5 * log2(pre2 / (s1 * s1)))) + 1, 2, nlv);
            const float sa = s1 * exp2(float(k - 2));
            ka = k - 1;
            kb = k;
            wl = saturate((pre2 - sa * sa) / (3.0 * sa * sa));
        }
    }

    float4 acc = float4(0, 0, 0, 0);
    float  ws  = 0.0;
    [loop]
    for (int dy = -n; dy <= n; dy++)
    {
        [loop]
        for (int dx = -n; dx <= n; dx++)
        {
            const float2 off = float2(float(dx), float(dy)) * s;
            const float  ax  = abs(off.x);
            const float  ay  = abs(off.y);
            float dist = length(off);
            [branch]
            if      (ishape == 2) dist = max(ax, ax * 0.5 + ay * 0.866025);
            else if (ishape == 3) dist = max(max(ax, ay), (ax + ay) * 0.707107);
            const float cov = saturate((r - dist) / s + 0.5);
            [branch]
            if (cov <= 0.0) continue;
            float4 c = mbl_lv(ka, full + off);
            [branch]
            if (wl > 0.0) c = lerp(c, mbl_lv(kb, full + off), wl);
            acc += c * cov;
            ws  += cov;
        }
    }
    return acc / max(ws, 0.000001);
}
]]

-- Lua (@マップぼかし)
local obj, math = obj, math

if radius <= 0 then return end
local W, H = obj.w, obj.h
if W < 1 or H < 1 then return end

local CACHE_BUDGET = 15000000
local is_filter = obj.getinfo("filter")
is_filter = (is_filter == true or is_filter == 1)

local lens   = (shape >= 1)
local high   = (quality == 1)
local taps_m = high and 24 or 12
-- 段の縮小: 段 k は σ_k / rho 以下で最大の 2 の累乗の画素ごとに 1 画素（標準 1 / 高 2）
local want_rho = high and 2 or 1
-- t = 1 のときの値（ガウスは σ、円などは半径）と、段の一番上の σ
--   円などの段は、隙間を埋める前ぼかしの最大 0.5 x (半径 / taps_m) まであればよい
local sig_max = lens and radius or radius / 2
local sig_top = lens and radius / (2 * taps_m) or radius / 2
local nlv = 0
if sig_top > 1 then nlv = math.min(7, math.ceil(math.log(sig_top) / math.log(2) - 1e-9)) end

-- 段 1 画素の幅（2 の累乗）
local function level_d(sig, rho)
  local d = 1
  while d * 2 <= sig / rho do d = d * 2 end
  return d
end

-- 広げる量 (px, py) と縮小 rho の段の大きさと、cache と tempbuffer の使用量の最大を数える
--   cache:mbl_src と cache:mbl_map（元の大きさ）＋ 作り終えた段 ＋ 作っている段 ＋ tempbuffer（横の 1 回目の結果。
--   幅は今の段、高さは 1 つ前の段の画素）
local function plan_levels(px, py, rho)
  local wb, hb = W + 2 * px, H + 2 * py
  local lv = {}
  local base = 2 * W * H
  local held, peak, pd = 0, 2 * W * H, 1
  for k = 1, nlv do
    local sig = sig_top * 2 ^ (k - nlv)
    local d = level_d(sig, rho)
    local lw, lh = math.ceil(wb / d), math.ceil(hb / d)
    local tmp = lw * math.ceil(hb / pd)
    peak = math.max(peak, base + held + lw * lh + tmp)
    held = held + lw * lh
    lv[k] = { sig = sig, d = d, w = lw, h = lh }
    pd = d
  end
  return lv, peak
end

-- ぼけがオブジェクトの外枠で切れないよう広げる（@玉ボケ の plan_pad と同じ考え。フィルタオブジェクトは広げない）
--   ガウスは 3σ、円などは 半径 ＋ 縁の覆い（0.5 s）と前ぼかし（1.5 s）。s の最大は 半径 / taps_m
--   枠を超えるなら、まず縮小を標準に戻し、それでも超えるなら広げる量を減らす（切れる位置が内側へ寄るだけ）
local want = lens and math.ceil(radius + 2 * radius / taps_m) or math.ceil(1.5 * radius)
local pad_x, pad_y, rho = 0, 0, 1
do
  local cap_x, cap_y = 0, 0
  if not is_filter then
    local max_w, max_h = obj.getinfo("image_max")
    cap_x = math.max(0, math.floor(((max_w or W) - W) / 2))
    cap_y = math.max(0, math.floor(((max_h or H) - H) / 2))
  end
  local function fits(p, r)
    local _, peak = plan_levels(math.min(p, cap_x), math.min(p, cap_y), r)
    return peak <= CACHE_BUDGET
  end
  local p0 = is_filter and 0 or want
  if want_rho > 1 and fits(p0, want_rho) then
    pad_x, pad_y, rho = math.min(p0, cap_x), math.min(p0, cap_y), want_rho
  else
    for p = p0, 0, -1 do
      if fits(p, 1) or p == 0 then
        pad_x, pad_y = math.min(p, cap_x), math.min(p, cap_y)
        break
      end
    end
  end
end
local lv, peak = plan_levels(pad_x, pad_y, rho)
if peak > CACHE_BUDGET then
  -- 広げなくても枠に収まらない大きな画像（目安は FHD の 1.8 倍の面積より上）。そのまま進むと最も長く使って
  -- いないバッファが黙って捨てられて絵が壊れるので、何もしない（警告は最初の 1 回だけ）
  if not MBL_BUDGET_WARNED then
    print("@warn", string.format("[マップぼかし@光学系ボケ] 画像が大きすぎるため効果を掛けません（%dx%d）", W, H))
    MBL_BUDGET_WARNED = true
  end
  return
end
local wb, hb = W + 2 * pad_x, H + 2 * pad_y
local smp = is_filter and "clamp" or "clip"
local black, white = black_pt / 100, white_pt / 100
local inv = invert and 1 or 0

obj.copybuffer("cache:mbl_src", "object")

-- [1] マップ
--   レイヤー: obj.load("layer") は画像と obj.* を読んだレイヤーのもので置き換えるので、両方を退避して戻す
--   （参照実装: ベクトルブラー_H / @キーイング_H）。読み込みに失敗したら何もしない。
--   マップのレイヤーが自分のレイヤーなら読み込まずに自分の明るさを使う（自分を読むと自分の効果がもう一度走る）
local map_built = false
if map_mode == 2 then
  local n = math.floor(map_layer + 0.5)
  if n ~= obj.layer then
    local saved = {
      obj.ox, obj.oy, obj.oz, obj.rx, obj.ry, obj.rz,
      obj.cx, obj.cy, obj.cz, obj.sx, obj.sy, obj.sz, obj.alpha, obj.zoom, obj.aspect,
    }
    local ok = obj.load("layer", n, map_fx)
    if ok and obj.w > 0 and obj.h > 0 then
      obj.clearbuffer("cache:mbl_map", W, H)
      obj.pixelshader("mbl_map", "cache:mbl_map", "object",
          { W, H, obj.w, obj.h, 0, map_fit, black, white, inv }, "copy", "clamp")
      map_built = true
    end
    obj.copybuffer("object", "cache:mbl_src")
    obj.ox, obj.oy, obj.oz, obj.rx, obj.ry, obj.rz,
    obj.cx, obj.cy, obj.cz, obj.sx, obj.sy, obj.sz, obj.alpha, obj.zoom, obj.aspect = unpack(saved)
    if not map_built then return end
  end
end
if not map_built then
  obj.clearbuffer("cache:mbl_map", W, H)
  obj.pixelshader("mbl_map", "cache:mbl_map", "cache:mbl_src",
      { W, H, W, H, (map_mode == 1) and 1 or 0, 0, black, white, inv }, "copy", "clamp")
end

if pad_x > 0 or pad_y > 0 then
  -- 中身は合成で全部描き直すので、広げた部分の塗りは何でもよい
  obj.effect("領域拡張", "上", pad_y, "下", pad_y, "左", pad_x, "右", pad_x, "塗りつぶし", 0)
end

-- [2] 段。段 k は 1 つ前の段（段 1 は元の画像）を横と縦のガウスでぼかして縮める
--   合成で読んだときの分散が σ_k^2 になるように、足す分散 tau を決める:
--     tau = σ_k^2 - e(d_k) - (σ_(k-1)^2 - e(d_(k-1))) - b
--     e(d): 合成が 1 画素ごとに段をバイリニアで読むときに足される分散の平均（d = 1 なら 0、偶数なら (2d^2 + 1) / 12）
--     b   : 1 つ前の段を、その画素のちょうど中間で読むときに足される分散（d_k > d_(k-1) なら d_(k-1)^2 / 4）
--   机上検証: AI/scripts/光学系ボケ/verify_map_blur.py（1 次元で段を作り、読んだときの分散を測る）
local function bilin_var(d)
  if d <= 1 then return 0 end
  return (2 * d * d + 1) / 12
end
local prev, pd, pw, ph, org_x, org_y = "cache:mbl_src", 1, W, H, pad_x, pad_y
local v_prev = 0
for k = 1, nlv do
  local L = lv[k]
  local b = (L.d > pd) and (pd * pd / 4) or 0
  local tau = math.max(0, L.sig * L.sig - bilin_var(L.d) - v_prev - b)
  local taps = math.ceil(3 * math.sqrt(tau) / pd)
  local tw, th = L.w, math.ceil(hb / pd)
  obj.clearbuffer("tempbuffer", tw, th)
  obj.pixelshader("mbl_gauss", "tempbuffer", prev,
      { L.d, pd, 1 / (pd * pw), 1 / (pd * ph), org_x, org_y, 1, 0, pd, taps, tau }, "copy", smp)
  obj.clearbuffer("cache:mbl_l" .. k, L.w, L.h)
  obj.pixelshader("mbl_gauss", "cache:mbl_l" .. k, "tempbuffer",
      { L.d, L.d, 1 / (L.d * tw), 1 / (pd * th), 0, 0, 0, 1, pd, taps, tau }, "copy", smp)
  v_prev = L.sig * L.sig - bilin_var(L.d)
  prev, pd, pw, ph, org_x, org_y = "cache:mbl_l" .. k, L.d, L.w, L.h, 0, 0
end
-- 使わない段は 1x1 にしておく（合成の入力に渡す名前はいつも 7 つ）
local ext = {}
for k = 1, 7 do
  local L = lv[k]
  if L then
    ext[k] = { 1 / (L.d * L.w), 1 / (L.d * L.h) }
  else
    obj.clearbuffer("cache:mbl_l" .. k, 1, 1)
    ext[k] = { 1, 1 }
  end
end

-- [3] 合成（出力は広げた大きさ。元の画像は (pad_x, pad_y) だけ内側）
local count_out = is_filter and 0 or 1
local mix_res = { "cache:mbl_src", "cache:mbl_map", "cache:mbl_l1", "cache:mbl_l2", "cache:mbl_l3",
                  "cache:mbl_l4", "cache:mbl_l5", "cache:mbl_l6", "cache:mbl_l7" }
if lens then
  obj.pixelshader("mbl_lens_mix", "object", mix_res,
      { pad_x, pad_y, W, H,
        ext[1][1], ext[1][2], ext[2][1], ext[2][2], ext[3][1], ext[3][2], ext[4][1], ext[4][2],
        ext[5][1], ext[5][2], ext[6][1], ext[6][2], ext[7][1], ext[7][2],
        sig_top, nlv, sig_max, count_out, shape, taps_m }, "copy", smp)
else
  obj.pixelshader("mbl_gauss_mix", "object", mix_res,
      { pad_x, pad_y, W, H,
        ext[1][1], ext[1][2], ext[2][1], ext[2][2], ext[3][1], ext[3][2], ext[4][1], ext[4][2],
        ext[5][1], ext[5][2], ext[6][1], ext[6][2], ext[7][1], ext[7][2],
        sig_top, nlv, sig_max, count_out, shape, taps_m }, "copy", smp)
end
